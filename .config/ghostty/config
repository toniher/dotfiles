# ghostty +list-fonts
font-family = "NotoMono Nerd Font"
font-size = 13

# ghostty +list-themes
theme = TokyoNight Night

mouse-hide-while-typing = false
shell-integration = zsh

maximize = true
mouse-scroll-multiplier = 0.8

window-decoration = true
window-padding-x = 8
window-padding-y = 8

background-opacity = 0.96

scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
clipboard-paste-protection = true
window-save-state = always

# Unbind CMD+... keys so they will be forwarded to Zellij
keybind = ctrl+t=unbind
keybind = ctrl+n=unbind
keybind = ctrl+c=unbind
keybind = ctrl+w=unbind
keybind = ctrl+opt+left=unbind
keybind = ctrl+opt+right=unbind

window-theme = ghostty
